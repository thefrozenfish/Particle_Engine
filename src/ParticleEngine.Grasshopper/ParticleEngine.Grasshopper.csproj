<Project Sdk="Microsoft.NET.Sdk">

  <!-- Keep the existing netstandard2.0 target and compile-only Rhino 7 API references.
       Ribbon branding is registered explicitly by ParticleEnginePriority.
       A target-framework change alone does not establish the cause of a missing tab. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>ParticleEngine</AssemblyName>
    <RootNamespace>ParticleEngine.Grasshopper</RootNamespace>
    <TargetExt>.gha</TargetExt>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="7.38.24338.17001" ExcludeAssets="runtime" />
    <PackageReference Include="Grasshopper" Version="7.38.24338.17001" ExcludeAssets="runtime" />
    <!-- Match the System.Drawing identity in Grasshopper 7's API. Reference assemblies
         are build-only and work on non-Windows build machines too. Rhino supplies runtime drawing. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" GeneratePathProperty="true" PrivateAssets="all" IncludeAssets="none" />
    <Reference Include="System.Drawing">
      <HintPath>$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)/build/.NETFramework/v4.8/System.Drawing.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Build-only, Windows-only: the ribbon is a WinForms control. Used solely by the opt-in,
         off-by-default tab-placement helper (RibbonPlacement), guarded by a Windows runtime check.
         Rhino supplies WinForms at runtime on Windows; the code path never runs on macOS. -->
    <Reference Include="System.Windows.Forms">
      <HintPath>$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)/build/.NETFramework/v4.8/System.Windows.Forms.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Core ships beside the .gha (ParticleEngine.Core.dll). -->
    <ProjectReference Include="..\ParticleEngine.Core\ParticleEngine.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\ParticleEngine16.png" LogicalName="ParticleEngine.Grasshopper.Resources.ParticleEngine16.png" />
    <EmbeddedResource Include="Resources\ParticleEngine24.png" LogicalName="ParticleEngine.Grasshopper.Resources.ParticleEngine24.png" />
    <!-- Per-component icons (one per ComponentSpec.Key); logical name
         ParticleEngine.Grasshopper.Resources.icons.<Key>.png. Regenerate with scripts/generate-icons.ps1. -->
    <EmbeddedResource Include="Resources\icons\*.png" LogicalName="ParticleEngine.Grasshopper.Resources.icons.%(Filename).png" />
  </ItemGroup>

</Project>

